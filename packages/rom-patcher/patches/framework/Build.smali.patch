# ZMMO Patch: android.os.Build static fields → Device Identity spoofing
# Target: framework.jar → android/os/Build.smali
# 
# Build holds static final fields that apps read for device identity.
# Most are set once in <clinit> from system properties at boot.
# This patch replaces the static initializer to read from persist.zmmo.* props.
#
# Fields to spoof (19 total):
#   BRAND, MODEL, MANUFACTURER, DEVICE, PRODUCT, BOARD, HARDWARE
#   FINGERPRINT, ID, DISPLAY, TYPE, TAGS, HOST, USER
#   BOOTLOADER, RADIO (baseband), SERIAL, SKU

.method public static constructor <clinit>()V
    .locals 3

    # --- Read each field, allow override via persist.zmmo.* ---

    # BRAND
    const-string v0, "ro.product.brand"
    invoke-static {v0}, Lzmmo/ZmmoProps;->get(Ljava/lang/String;)Ljava/lang/String;
    move-result-object v1
    sput-object v1, Landroid/os/Build;->BRAND:Ljava/lang/String;

    # MODEL
    const-string v0, "ro.product.model"
    invoke-static {v0}, Lzmmo/ZmmoProps;->get(Ljava/lang/String;)Ljava/lang/String;
    move-result-object v1
    sput-object v1, Landroid/os/Build;->MODEL:Ljava/lang/String;

    # MANUFACTURER
    const-string v0, "ro.product.manufacturer"
    invoke-static {v0}, Lzmmo/ZmmoProps;->get(Ljava/lang/String;)Ljava/lang/String;
    move-result-object v1
    sput-object v1, Landroid/os/Build;->MANUFACTURER:Ljava/lang/String;

    # DEVICE (codename)

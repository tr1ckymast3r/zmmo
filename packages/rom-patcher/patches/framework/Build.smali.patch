    const-string v0, "ro.build.version.security_patch"
    invoke-static {v0}, Lzmmo/ZmmoProps;->get(Ljava/lang/String;)Ljava/lang/String;
    move-result-object v1
    sput-object v1, Landroid/os/Build$VERSION;->SECURITY_PATCH:Ljava/lang/String;

    return-void
.end method
